      "versionNonce": 655866486,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769958748761,
      "link": null,
      "locked": false,
      "text": "public void inizializaBFS() {\n    for (Vertice v : this.verticesGlobais) {\n        v.marcado = 0;\n    }\n\n    Fila novaFila = new Fila();\n    \n    for (Vertice v : this.verticesGlobais()) {\n        if (v.marcado == 0) {\n            novaFila.enqueue(v);\n            this.BFS(novaFila);\n        }\n    }\n}\n\nprivate void BFS (Fila fila) {\n    while (!fila.isEmpty()) {\n        Vertice v = fila.dequeue();\n        System.out.prinln(v.valor);\n        v.marcado = 1;\n\n        for (Vertice w : v.adjacemtes()) {\n            if (w.marcado == 0) {\n                w.marcado = -1;\n                fila.enqueue(w);\n            }\n        }\n    } \n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public void inizializaBFS() {\n    for (Vertice v : this.verticesGlobais) {\n        v.marcado = 0;\n    }\n\n    Fila novaFila = new Fila();\n    \n    for (Vertice v : this.verticesGlobais()) {\n        if (v.marcado == 0) {\n            novaFila.enqueue(v);\n            this.BFS(novaFila);\n        }\n    }\n}\n\nprivate void BFS (Fila fila) {\n    while (!fila.isEmpty()) {\n        Vertice v = fila.dequeue();\n        System.out.prinln(v.valor);\n        v.marcado = 1;\n\n        for (Vertice w : v.adjacemtes()) {\n            if (w.marcado == 0) {\n                w.marcado = -1;\n                fila.enqueue(w);\n            }\n        }\n    } \n}",
      "autoResize": true,
      "lineHeight": 1.25
    }
