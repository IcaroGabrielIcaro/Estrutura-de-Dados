      "isDeleted": false,
      "boundElements": null,
      "updated": 1769957653829,
      "link": null,
      "locked": false,
      "text": "public void startDFS() {\n    for (Vertice v : this.verticesGlobais) {\n        v.marcado = 0;\n    }\n\n    for (Vertice v : this.verticesGlobais) {\n        if (v.marcado == 0) {\n            this.DFS(v);\n        }\n    }\n}\n\nprivate void DFS(Vertice v) {\n    System.out.println(v.valor);\n    v.marcado = 1;\n\n    for (Vertice w : v.adjacentes()) {\n        if (w.marcado == 0) {\n            this.DFS(w);\n        }\n    }\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public void startDFS() {\n    for (Vertice v : this.verticesGlobais) {\n        v.marcado = 0;\n    }\n\n    for (Vertice v : this.verticesGlobais) {\n        if (v.marcado == 0) {\n            this.DFS(v);\n        }\n    }\n}\n\nprivate void DFS(Vertice v) {\n    System.out.println(v.valor);\n    v.marcado = 1;\n\n    for (Vertice w : v.adjacentes()) {\n        if (w.marcado == 0) {\n            this.DFS(w);\n        }\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
